#!/bin/bash
# Runs the agent-tools CLI with a Python that has the MCP client library: the
# host install's venv (mcp-tools/install.sh), else this repo's.
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
for py in "$HOME/.local/share/mcp-tools/.venv/bin/python" "$here/../mcp-tools/.venv/bin/python"; do
  [ -x "$py" ] && exec "$py" "$here/agent_tools_cli.py" "$@"
done
echo "agent-tools: no Python with the mcp package — run mcp-tools/install.sh" >&2
exit 1
