#!/usr/bin/env python3
"""fanout — an orchestrator hands a list of small, independent tasks to cheap workers (free DeepSeek on
OpenCode Zen by default), then a verify command (build, tests, lint) is run and the workers fix their own
failures. The orchestrator writes only the job file; the workers do the work. See skills/fanout/SKILL.md.

  fanout job.json              # run it
  fanout job.json --dry-run    # print the plan, change nothing
  fanout --example             # print an example job file

Job file (JSON). Paths in "files" are relative to "workdir".
  name      short id, used for the branch and the report folder
  repo      git repo to work in. A worktree is made next to it on branch fanout/<name> (never your main checkout)
  base      branch or commit to start from (default HEAD)
  workdir   subfolder of the worktree the workers run in (default ".")
  model     opencode model id (default opencode/deepseek-v4.1-flash-free)
  provider  openrouter/ models only: OpenRouter routing (default {"sort": "price"}, cheapest host first)
  small_model  model for opencode's title calls (default: the job's model; OpenRouter's default is Nano Banana)
  parallel  workers at once (default 6; the free tier drops requests silently when flooded)
  rules     text put in front of every task prompt (conventions, what not to touch)
  tasks     [{"id": "...", "prompt": "...", "files": ["path it may write", ...]}]
            "edit": true = the task changes files that already exist (pending until git sees them change)
  verify    {"cmd": "...", "cwd": ".", "max_rounds": 4, "error_regex": "(file):(line):..: error: (msg)"}
            error_regex groups: 1 = file path, 2 = line, 3 = message. Errors in a task's file go back to that task's
            worker; anything else goes to one worker that may edit all task files.
  locked    ["path or glob", ...] workers may read but never change (tests, contracts); restored after every
            worker pass, and each attempt to change one is logged in the report
  forbid    [{"pattern": "regex", "files": "glob (default: the task files)", "why": "..."}]: a match counts as a
            failed verify and goes back to the file's worker, like a compile error
  after     [shell commands run once verify passes, e.g. screenshots]
  commit    true (default): commit only the task files on the branch
The report lists tokens from opencode's log (its cost is a list-price estimate) and, for openrouter/ models,
the billed USD from the key's usage counter before/after the run.
Exit 0 if every task produced its files and verify passed; 1 otherwise. Report: ~/.fanout/runs/<name>-<time>/report.md
"""
import argparse
import concurrent.futures as cf
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

def _find_opencode():
    for c in (os.environ.get("FANOUT_OPENCODE"), os.path.expanduser("~/.opencode/bin/opencode"),
              os.path.expanduser("~/.local/bin/opencode"), shutil.which("opencode")):
        if c and os.path.exists(c):
            return c
    return os.path.expanduser("~/.opencode/bin/opencode")


OC = _find_opencode()
DEFAULT_MODEL = "opencode/deepseek-v4.1-flash-free"
EXAMPLE = {
    "name": "demo", "repo": "~/Documents/personal/some-repo", "workdir": ".", "parallel": 4,
    "rules": "Write plain Python 3, stdlib only. Touch only the files you are told to write.",
    "tasks": [
        {"id": "slug", "prompt": "Write slug(text) that lowercases and joins words with '-'. Add a test_slug function.",
         "files": ["util/slug.py"]},
        {"id": "wrap", "prompt": "Write wrap(text, width) that word-wraps text. Add a test_wrap function.",
         "files": ["util/wrap.py"]},
    ],
    "verify": {"cmd": "python3 -m pytest -q util", "cwd": ".", "max_rounds": 3,
               "error_regex": "^(\\S+\\.py):(\\d+): (.+)$"},
    "after": [], "commit": True,
}


def _openrouter_key():
    """The key opencode uses (its auth.json), else $OPENROUTER_API_KEY, else keys.env. Never printed."""
    try:
        k = json.load(open(os.path.expanduser("~/.local/share/opencode/auth.json"))).get("openrouter", {}).get("key")
        if k:
            return k
    except Exception:
        pass
    if os.environ.get("OPENROUTER_API_KEY"):
        return os.environ["OPENROUTER_API_KEY"]
    try:
        for line in open(os.path.expanduser("~/Documents/secrets/keys.env")):
            if line.startswith("OPENROUTER_API_KEY="):
                return line.split("=", 1)[1].strip().strip('"\'')
    except Exception:
        pass
    return None


def billed_usage():
    """OpenRouter's billed total for the key, in USD (None if unknown). The counter lags a few seconds."""
    k = _openrouter_key()
    if not k:
        return None
    try:
        import urllib.request
        req = urllib.request.Request("https://openrouter.ai/api/v1/key", headers={"Authorization": "Bearer " + k})
        return float(json.load(urllib.request.urlopen(req, timeout=20))["data"]["usage"])
    except Exception:
        return None


def opencode_tokens(directory):
    """Tokens opencode logged for sessions in this folder, and its own cost estimate (list price)."""
    db = os.path.expanduser("~/.local/share/opencode/opencode.db")
    if not os.path.exists(db):
        return None
    import sqlite3
    try:
        c = sqlite3.connect("file:%s?mode=ro" % db, uri=True)
        r = c.execute("select count(*), sum(tokens_input), sum(tokens_output), sum(tokens_reasoning), "
                      "sum(tokens_cache_read), sum(cost) from session where directory = ?", (str(directory),)).fetchone()
        c.close()
        return dict(zip(("sessions", "input", "output", "reasoning", "cache_read", "estimate_usd"), [x or 0 for x in r]))
    except Exception:
        return None


def sh(cmd, cwd, env=None, timeout=900):
    r = subprocess.run(cmd, cwd=cwd, shell=isinstance(cmd, str), capture_output=True, text=True, env=env, timeout=timeout)
    return r.returncode, (r.stdout + r.stderr)


class Run:
    def __init__(self, job, dry):
        self.job, self.dry = job, dry
        self.name = re.sub(r"[^a-zA-Z0-9_-]", "-", job.get("name", "job"))
        self.model = job.get("model", DEFAULT_MODEL)
        self.parallel = int(job.get("parallel", 6))
        self.rules = job.get("rules", "")
        self.tasks = job["tasks"]
        self.repo = Path(os.path.expanduser(job["repo"])).resolve()
        self.tree = self.repo.parent / ("%s-wt-fanout-%s" % (self.repo.name, self.name))
        self.work = self.tree / job.get("workdir", ".")
        self.out = Path.home() / ".fanout" / "runs" / ("%s-%s" % (self.name, time.strftime("%Y%m%d-%H%M%S")))
        self.log = {"name": self.name, "model": self.model, "tasks": {}, "rounds": [], "stray": []}
        # opencode takes its folder from $PWD, not the process cwd, and refuses writes in a git worktree unless
        # external_directory is allowed. Both cost a failed first run to find out.
        cfg = {"permission": {"external_directory": "allow"}}
        if self.model.startswith("openrouter/"):
            # OpenRouter spreads requests over every host of a model, many 2-15x the listed price; ask for the
            # cheapest first (it still falls back). opencode's title calls go to its own small model (Nano Banana
            # on OpenRouter), billed on the same key: keep them on the job's model.
            mid = self.model.split("/", 1)[1]
            cfg["provider"] = {"openrouter": {"models": {mid: {"options": {
                "provider": job.get("provider", {"sort": "price"})}}}}}
            cfg["small_model"] = job.get("small_model", self.model)
        self.env = dict(os.environ, PWD=str(self.work), OPENCODE_CONFIG_CONTENT=json.dumps(cfg))

    # -- worktree
    def setup(self):
        if self.dry:
            return
        if not self.tree.exists():
            base = self.job.get("base", "HEAD")
            rc, out = sh(["git", "worktree", "add", "-b", "fanout/" + self.name, str(self.tree), base], self.repo)
            if rc:  # branch may already exist
                rc, out = sh(["git", "worktree", "add", str(self.tree), "fanout/" + self.name], self.repo)
            if rc:
                sys.exit("could not make the worktree: " + out.strip())
        # where this branch left the repo's current branch: "edit" tasks count as done once their files differ from it
        rc, src = sh(["git", "rev-parse", "HEAD"], self.repo)
        rc, mb = sh(["git", "merge-base", "HEAD", src.strip()], str(self.tree))
        self.base_sha = mb.strip() or "HEAD"
        self.out.mkdir(parents=True, exist_ok=True)
        self.locked = {}
        for g in self.job.get("locked", []):
            for f in sorted(self.work.glob(g)):
                if f.is_file():
                    self.locked[f] = f.read_bytes()

    def guard(self, when):
        """Put locked files back as they were at the start; log what a worker changed."""
        for f, data in getattr(self, "locked", {}).items():
            if not f.exists() or f.read_bytes() != data:
                f.parent.mkdir(parents=True, exist_ok=True)
                f.write_bytes(data)
                self.log.setdefault("locked_touched", []).append("%s (%s)" % (f.relative_to(self.work), when))

    def forbidden(self):
        """Matches of the job's forbid patterns: ["file:line forbidden (why): text"]."""
        hits = []
        task_files = [f for t in self.tasks for f in t["files"]]
        for rule in self.job.get("forbid", []):
            rx = re.compile(rule["pattern"])
            files = [str(f.relative_to(self.work)) for f in self.work.glob(rule["files"])] if rule.get("files") else task_files
            for f in files:
                path = self.work / f
                if not path.is_file():
                    continue
                for n, line in enumerate(path.read_text(errors="replace").splitlines(), 1):
                    if rx.search(line):
                        hits.append("%s:%d: error: forbidden (%s): %s" % (f, n, rule.get("why", rule["pattern"]), line.strip()[:160]))
        return hits

    # -- one worker
    def worker(self, prompt, tag):
        t = time.time()
        try:
            r = subprocess.run([OC, "run", "-m", self.model, prompt], cwd=str(self.work), capture_output=True, text=True,
                               stdin=subprocess.DEVNULL, timeout=int(self.job.get("worker_timeout", 300)), env=self.env)
            rc, out = r.returncode, r.stdout + r.stderr
        except subprocess.TimeoutExpired:
            rc, out = "timeout", ""
        (self.out / "workers.log").open("a").write("--- %s rc=%s %.0fs\n%s\n" % (tag, rc, time.time() - t, out[-700:]))
        return rc, time.time() - t

    def locked_note(self):
        g = self.job.get("locked")
        return (" These files are locked (read them, never change them; any change is reverted): %s. If a locked test "
                "fails, the code is wrong, not the test." % ", ".join(g)) if g else ""

    def task_prompt(self, task):
        files = ", ".join(task["files"])
        return ("%s\n\nYou may write ONLY these files (paths relative to the current directory): %s. Do not edit any other file, "
                "do not run git, and do not run the build or tests (the orchestrator does that).%s\n\nTask: %s\n\n"
                "Reply with one line when done." % (self.rules, files, self.locked_note(), task["prompt"]))

    def missing(self, task):
        gone = [f for f in task["files"] if not (self.work / f).exists()]
        if gone or not task.get("edit"):
            return gone
        # an "edit" task changes files that already exist: it is pending until git sees a change in them
        r = subprocess.run(["git", "diff", "--quiet", getattr(self, "base_sha", "HEAD"), "--"] + task["files"], cwd=self.work)
        return [] if r.returncode else list(task["files"])

    # -- stage 1: write
    def write_all(self):
        for attempt in range(4):
            todo = [t for t in self.tasks if self.missing(t)]
            if not todo:
                return
            par = self.parallel if attempt == 0 else max(2, self.parallel // 2)

            def go(task):
                rc, s = self.worker(self.task_prompt(task), "write:%s" % task["id"])
                e = self.log["tasks"].setdefault(task["id"], {"attempts": 0, "seconds": 0.0, "fix_rounds": 0})
                e["attempts"] += 1
                e["seconds"] = round(e["seconds"] + s, 1)
            with cf.ThreadPoolExecutor(par) as ex:
                list(ex.map(go, todo))
            self.guard("write")

    # -- stage 2: verify and fix
    def verify(self):
        v = self.job.get("verify")
        if not v:
            return True
        rx = re.compile(v["error_regex"], re.M) if v.get("error_regex") else None
        for rnd in range(1, int(v.get("max_rounds", 4)) + 2):
            rc, out = sh(v["cmd"], str(self.work / v.get("cwd", ".")))
            hits = self.forbidden()
            if hits:
                out = out + "\n" + "\n".join(hits)
            (self.out / ("verify-%d.log" % rnd)).write_text(out[-20000:])
            self.log["rounds"].append({"round": rnd, "ok": rc == 0 and not hits, "forbidden": len(hits)})
            if rc == 0 and not hits:
                return True
            if rnd > int(v.get("max_rounds", 4)):
                return False
            # the same failures after a fix round: the workers are stuck (often two locked tests that disagree, or an
            # error outside every task's files). Stop and leave it to the orchestrator instead of paying for more rounds.
            sig = sorted(set(re.sub(r"\(\d+(\.\d+)? seconds\)", "", l).strip() for l in out.splitlines()
                             if "error" in l or "failed" in l))
            if sig and sig == getattr(self, "_last_sig", None):
                self.log["stalled"] = rnd
                return False
            self._last_sig = sig
            owned, other = {}, []
            frx = re.compile(r"^(\S+):(\d+): error: (forbidden .*)$", re.M)
            matches = list(rx.finditer(out)) if rx else []
            matches += list(frx.finditer("\n".join(hits)))
            for m in matches:
                f, line, msg = m.group(1), m.group(2), m.group(3)
                task = next((t for t in self.tasks if any(f.endswith(x) for x in t["files"])), None)
                (owned.setdefault(task["id"], []) if task else other).append("%s:%s %s" % (os.path.basename(f), line, msg))
            if not owned and not other:
                other = out.strip().splitlines()[-25:]
            fixes = []
            for task in self.tasks:
                if task["id"] in owned:
                    fixes.append((task, owned[task["id"]], "fix:%s" % task["id"]))
            if other:
                fixes.append(({"id": "_all", "files": [f for t in self.tasks for f in t["files"]]}, other, "fix:_all"))

            def fix(item):
                task, errs, tag = item
                p = ("The verify command `%s` fails. Fix it by editing ONLY these files (relative to the current directory): %s. "
                     "Do not run builds, tests or git.%s Relevant output:\n%s\n\nReply with one line when done."
                     % (v["cmd"], ", ".join(task["files"]), self.locked_note(), "\n".join(errs[:15])))
                self.worker(p, tag)
                if task["id"] != "_all":
                    e = self.log["tasks"].setdefault(task["id"], {"attempts": 0, "seconds": 0.0, "fix_rounds": 0})
                    e["fix_rounds"] += 1
                else:
                    self.log["catch_all_fixes"] = self.log.get("catch_all_fixes", 0) + 1
            with cf.ThreadPoolExecutor(max(1, self.parallel)) as ex:
                list(ex.map(fix, fixes))
            self.guard("fix round %d" % rnd)
        return False

    # -- stage 3: after, stray changes, commit
    def finish(self, verified):
        if verified:
            for cmd in self.job.get("after", []):
                rc, out = sh(cmd, str(self.work))
                self.log.setdefault("after", []).append({"cmd": cmd, "rc": rc})
        allowed = set()
        for t in self.tasks:
            for f in t["files"]:
                allowed.add(os.path.normpath(os.path.join(self.job.get("workdir", "."), f)))
        rc, out = sh(["git", "status", "--porcelain", "-uall"], str(self.tree))
        for line in out.splitlines():
            p = line[3:].strip().strip('"')
            if "__pycache__" in p or p.endswith(".pyc") or ".DS_Store" in p:
                continue
            if os.path.normpath(p) not in allowed and not any(os.path.normpath(p).startswith(a + os.sep) for a in allowed):
                self.log["stray"].append(p)
        if self.job.get("commit", True):
            files = [os.path.join(self.job.get("workdir", "."), f) for t in self.tasks for f in t["files"]
                     if (self.work / f).exists()]
            if files:
                sh(["git", "add", "--"] + files, str(self.tree))
                sh(["git", "commit", "-q", "-m",
                    "fanout %s: %d tasks by %s\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>"
                    % (self.name, len(self.tasks), self.model)], str(self.tree))

    def report(self, verified, secs):
        done = [t["id"] for t in self.tasks if not self.missing(t)]
        lost = [t["id"] for t in self.tasks if self.missing(t)]
        lines = ["# fanout %s" % self.name, "", "- model: %s" % self.model, "- worktree: %s (branch fanout/%s)" % (self.tree, self.name),
                 "- tasks written: %d/%d%s" % (len(done), len(self.tasks), (" (missing: %s)" % ", ".join(lost)) if lost else ""),
                 "- verify: %s after %d run(s)" % ("PASSED" if verified else "FAILED", len(self.log["rounds"])),
                 "- total time: %.0fs" % secs]
        tok = opencode_tokens(self.work)
        if tok:
            self.log["tokens"] = tok
            lines.append("- tokens (opencode log, %d sessions): %s input, %s output, %s reasoning, %s cache read; "
                         "list-price estimate $%.3f" % (tok["sessions"], f"{tok['input']:,}", f"{tok['output']:,}",
                                                        f"{tok['reasoning']:,}", f"{tok['cache_read']:,}", tok["estimate_usd"]))
        if self.model.startswith("openrouter/") and self.billed0 is not None:
            time.sleep(15)  # OpenRouter's counter lags
            b1 = billed_usage()
            if b1 is not None:
                self.log["billed_usd"] = round(b1 - self.billed0, 4)
                lines.append("- billed by OpenRouter: $%.3f (key's usage counter before/after; the key is shared, so "
                             "anything else using it meanwhile is in here too)" % (b1 - self.billed0))
        lines.append("")
        lines += ["| task | write attempts | worker seconds | fix rounds |", "|---|---|---|---|"]
        for t in self.tasks:
            e = self.log["tasks"].get(t["id"], {})
            lines.append("| %s | %s | %s | %s |" % (t["id"], e.get("attempts", 0), e.get("seconds", 0), e.get("fix_rounds", 0)))
        if self.log.get("stalled"):
            lines += ["", "Stopped at verify run %d: the same failures as the run before, after a fix round. Look at them "
                      "yourself (two locked tests that disagree, or an error outside every task's files)." % self.log["stalled"]]
        if self.log.get("catch_all_fixes"):
            lines += ["", "Catch-all fix rounds (errors not tied to one task): %d" % self.log["catch_all_fixes"]]
        if self.log.get("locked_touched"):
            lines += ["", "Locked files a worker changed (reverted): " + ", ".join(self.log["locked_touched"])]
        rc, num = sh(["git", "diff", "--numstat", self.base_sha], str(self.tree))
        if num.strip():
            rows = [l.split("\t") for l in num.strip().splitlines() if l.count("\t") >= 2]
            lines += ["", "| file | + | - |", "|---|---|---|"] + ["| %s | %s | %s |" % (r[2], r[0], r[1]) for r in rows]
        if self.log["stray"]:
            lines += ["", "Files changed outside the allowed list (check them): " + ", ".join(self.log["stray"])]
        text = "\n".join(lines) + "\n"
        (self.out / "report.md").write_text(text)
        (self.out / "report.json").write_text(json.dumps(self.log, indent=1))
        print(text + "\nreport: %s" % (self.out / "report.md"))


def main():
    ap = argparse.ArgumentParser(description="fan tasks out to cheap workers, verify, let them fix")
    ap.add_argument("job", nargs="?")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--example", action="store_true")
    a = ap.parse_args()
    if a.example:
        print(json.dumps(EXAMPLE, indent=2)); return 0
    if not a.job:
        ap.error("job file required")
    if not os.path.exists(OC):
        sys.exit("opencode not found (looked in ~/.opencode/bin, ~/.local/bin, PATH; or set FANOUT_OPENCODE)")
    job = json.load(open(os.path.expanduser(a.job)))
    for t in job["tasks"]:
        if not t.get("files"):
            sys.exit("task %s has no files" % t.get("id"))
    run = Run(job, a.dry_run)
    if a.dry_run:
        print("worktree %s (branch fanout/%s)\nmodel %s, %d workers at once, %d tasks" % (run.tree, run.name, run.model, run.parallel, len(run.tasks)))
        for t in run.tasks:
            print(" -", t["id"], "->", ", ".join(t["files"]))
        print("verify:", (job.get("verify") or {}).get("cmd", "(none)")); return 0
    t0 = time.time()
    run.billed0 = billed_usage() if run.model.startswith("openrouter/") else None
    run.setup()
    run.write_all()
    ok = run.verify()
    run.finish(ok)
    run.report(ok, time.time() - t0)
    return 0 if ok and all(not run.missing(t) for t in run.tasks) else 1


if __name__ == "__main__":
    sys.exit(main())
