#!/usr/bin/env python3
"""shot-shrink — shrink raw screenshots before an agent reads them (images cost tokens by pixels: w*h/750).

  shot-shrink /tmp/x.png [more.png] [--width 800]

Downscales each PNG in place to at most --width px wide (never enlarges) and prints "path WxH ~Ntokens".
Use after `agent-browser screenshot` or a cua-driver screenshot, before Read. For web UI checks use ui-shot,
which does this itself. JPEG doesn't help: tokens depend on pixels, not file size.
"""
import subprocess, sys

def size(p):
    h = open(p, "rb").read(24)
    if h[:8] != b"\x89PNG\r\n\x1a\n":
        sys.exit(f"shot-shrink: {p} is not a PNG")
    return int.from_bytes(h[16:20], "big"), int.from_bytes(h[20:24], "big")

def shrink(p, width):
    if size(p)[0] <= width:
        return
    try:
        if sys.platform == "darwin":
            subprocess.run(["sips", "--resampleWidth", str(width), p], capture_output=True, timeout=30, check=True); return
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        from PIL import Image
        im = Image.open(p); im.resize((width, round(im.height * width / im.width)), Image.LANCZOS).save(p); return
    except ImportError:
        pass
    for exe in (["magick"], ["convert"]):
        try:
            subprocess.run([*exe, p, "-resize", f"{width}x", p], capture_output=True, timeout=30, check=True); return
        except (OSError, subprocess.SubprocessError):
            continue

args = sys.argv[1:]
width = 800
if "--width" in args:
    i = args.index("--width"); width = int(args[i + 1]); del args[i:i + 2]
if not args:
    sys.exit(__doc__)
for p in args:
    shrink(p, width)
    w, h = size(p)
    print(f"{p} {w}x{h} ~{w * h // 750} tokens")
