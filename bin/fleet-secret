#!/usr/bin/env bash
# fleet-secret: the one secrets command on every machine (aibo-linux, aibo-mac). `pa-secret` is an
# alias for it.
#
# The source of truth is ~/Documents/secrets/keys.env (mode 600, KEY=VALUE lines). This was decided
# by Sandesh on 2026-10-07 (D4). On macOS every write is mirrored to the login Keychain (service
# "personal-agent", base64 values, the same format the old pa-secret used), and `get` falls back to
# the Keychain if the file doesn't have a name. Elsewhere there is no Keychain and the file is all
# there is.
#
# Usage:
#   fleet-secret get    NAME
#   fleet-secret set    NAME [VALUE]          # VALUE omitted -> hidden prompt, or stdin if piped
#   fleet-secret rm     NAME
#   fleet-secret list                          # names only
#   fleet-secret check  NAME...                # exit 0 only if every NAME has a value
#   fleet-secret env    [PREFIX]               # `export NAME=...` lines
#   fleet-secret run    NAME[,NAME...] -- cmd args...   # inject only those names, then exec
#   fleet-secret import FILE                   # merge KEY=VALUE lines from FILE
#   fleet-secret render TEMPLATE OUT           # write OUT (mode 600) with ${NAME} replaced by values
#   fleet-secret sync   [--to-keychain|--from-keychain]  # macOS: copy file -> Keychain (default),
#                                              # or fill names missing from the file from the Keychain
#   fleet-secret backup                        # copy keys.env into 1Password as a Secure Note
#                                              # ("keys.env - <machine>"); needs the `op` CLI signed in
#   fleet-secret where                         # print the store path
#
# Env: FLEET_SECRETS_FILE (default ~/Documents/secrets/keys.env), FLEET_SECRET_SERVICE (Keychain
# service, default personal-agent), FLEET_SECRET_OP_VAULT (1Password vault for `backup`).
# Values must be one line. Store JSON minified and PEM keys base64-encoded.
# Docs: aibo-server/infrastructure/secrets.md

set -euo pipefail

FILE="${FLEET_SECRETS_FILE:-$HOME/Documents/secrets/keys.env}"
SERVICE="${FLEET_SECRET_SERVICE:-${PA_SECRET_SERVICE:-personal-agent}}"
ME="$(basename "$0")"
IS_MAC=0; [ "$(uname -s)" = "Darwin" ] && IS_MAC=1

die() { printf '%s: %s\n' "$ME" "$*" >&2; exit 1; }
valid() { [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid name '$1' (use A-Z, 0-9, _)"; }

ensure_file() {
  if [ ! -f "$FILE" ]; then
    mkdir -p "$(dirname "$FILE")"; chmod 700 "$(dirname "$FILE")" 2>/dev/null || true
    ( umask 077; : > "$FILE" )
  fi
  chmod 600 "$FILE"
}

# Read one value from the file: the last `[export ]NAME=...` line wins; surrounding quotes are stripped.
file_get() {
  [ -f "$FILE" ] || return 1
  local line v found=1
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line#export }"
    case "$line" in "$1="*) v="${line#*=}"; found=0 ;; esac
  done < "$FILE"
  [ $found -eq 0 ] || return 1
  v="${v%"${v##*[![:space:]]}"}"
  case "$v" in \"*\") v="${v#\"}"; v="${v%\"}"; v="${v//\\\"/\"}"; v="${v//\\\\/\\}" ;; \'*\') v="${v#\'}"; v="${v%\'}" ;; esac
  printf '%s' "$v"
}

file_names() {
  [ -f "$FILE" ] || return 0
  sed -n -E 's/^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=.*/\2/p' "$FILE" | awk '!seen[$0]++'
}

# Quote only when needed, so systemd EnvironmentFile, docker --env-file and `source` all read it the same.
quote() {
  local v="$1"
  if [[ "$v" =~ ^[A-Za-z0-9_./:@%+,=-]*$ ]]; then printf '%s' "$v"
  else v="${v//\\/\\\\}"; v="${v//\"/\\\"}"; printf '"%s"' "$v"; fi
}

# Replace NAME's line in place (keeps comments and order), or append. Atomic, stays 600.
file_set() {
  ensure_file
  local tmp; tmp="$(mktemp "$FILE.XXXXXX")"; chmod 600 "$tmp"
  local newline; newline="$1=$(quote "$2")"
  FS_N="$1" FS_NL="$newline" awk '
    BEGIN { n=ENVIRON["FS_N"]; nl=ENVIRON["FS_NL"] }
    { s=$0; sub(/^[ \t]*(export[ \t]+)?/, "", s) }
    index(s, n "=") == 1 { if (!done) { print nl; done=1 }; next }
    { print }
    END { if (!done) print nl }' "$FILE" > "$tmp"
  mv "$tmp" "$FILE"
}

file_rm() {
  [ -f "$FILE" ] || return 1
  file_get "$1" >/dev/null || return 1
  local tmp; tmp="$(mktemp "$FILE.XXXXXX")"; chmod 600 "$tmp"
  awk -v n="$1" '{ s=$0; sub(/^[ \t]*(export[ \t]+)?/, "", s) } index(s, n "=") == 1 { next } { print }' "$FILE" > "$tmp"
  mv "$tmp" "$FILE"
}

kc_get() {
  [ $IS_MAC -eq 1 ] || return 1
  local s; s="$(security find-generic-password -a "$1" -s "$SERVICE" -w 2>/dev/null)" || return 1
  printf '%s' "$s" | base64 --decode 2>/dev/null
}
kc_set() {
  [ $IS_MAC -eq 1 ] || return 0
  security add-generic-password -U -a "$1" -s "$SERVICE" -w "$(printf '%s' "$2" | base64)" \
    -j "fleet-secret mirror of keys.env (base64)" >/dev/null 2>&1 || printf '%s: warning: Keychain copy of %s not updated\n' "$ME" "$1" >&2
}
kc_rm() { [ $IS_MAC -eq 1 ] && security delete-generic-password -a "$1" -s "$SERVICE" >/dev/null 2>&1 || true; }
kc_names() {
  [ $IS_MAC -eq 1 ] || return 0
  security dump-keychain 2>/dev/null | awk -v svc="$SERVICE" '
    /^keychain:/ { a=""; s="" }
    /"acct"<blob>=/ { l=$0; sub(/.*"acct"<blob>="/,"",l); sub(/"$/,"",l); a=l }
    /"svce"<blob>=/ { l=$0; sub(/.*"svce"<blob>="/,"",l); sub(/"$/,"",l); if (l==svc && a!="") print a }' | sort -u
}

get() { file_get "$1" || kc_get "$1"; }

cmd_get() { [ -n "${1:-}" ] || die "usage: $ME get NAME"; valid "$1"; get "$1" || die "no such secret: $1"; }

cmd_set() {
  local name="${1:-}"; [ -n "$name" ] || die "usage: $ME set NAME [VALUE]"; valid "$name"; shift
  local value
  if [ $# -gt 0 ]; then value="$1"
  elif [ ! -t 0 ]; then value="$(cat)"
  else read -r -s -p "value for $name: " value; echo >&2; fi
  [ -n "$value" ] || die "refusing to store an empty value for $name"
  case "$value" in *$'\n'*) die "$name: values must be one line (minify JSON, base64 PEM keys)";; esac
  file_set "$name" "$value"; kc_set "$name" "$value"
  printf 'stored %s in %s\n' "$name" "$FILE" >&2
}

cmd_rm() {
  [ -n "${1:-}" ] || die "usage: $ME rm NAME"; valid "$1"
  local hit=0; file_rm "$1" && hit=1
  if [ $IS_MAC -eq 1 ] && kc_get "$1" >/dev/null 2>&1; then kc_rm "$1"; hit=1; fi
  [ $hit -eq 1 ] || die "no such secret: $1"
  printf 'removed %s\n' "$1" >&2
}

cmd_list() { { file_names; kc_names; } | awk '!seen[$0]++'; }

cmd_check() {
  local missing="" n
  for n in "$@"; do get "$n" >/dev/null 2>&1 || missing="$missing $n"; done
  [ -z "$missing" ] || { printf '%s: missing:%s\n' "$ME" "$missing" >&2; exit 1; }
}

cmd_env() {
  local n
  cmd_list | while IFS= read -r n; do
    [ -n "$n" ] || continue
    [ -n "${1:-}" ] && [[ "$n" != "$1"* ]] && continue
    printf 'export %s=%q\n' "$n" "$(get "$n")"
  done
}

cmd_run() {
  local names="${1:-}"; shift || true
  [ "${1:-}" = "--" ] && shift
  [ -n "$names" ] && [ $# -gt 0 ] || die "usage: $ME run NAME[,NAME...] -- cmd args..."
  local n v
  for n in ${names//,/ }; do valid "$n"; v="$(get "$n")" || die "no such secret: $n"; export "$n=$v"; done
  exec "$@"
}

cmd_import() {
  local f="${1:-}"; [ -f "$f" ] || die "no such file: $f"
  local line k v c=0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in ''|\#*) continue;; *=*) ;; *) continue;; esac
    k="${line%%=*}"; k="${k#export }"; k="${k%"${k##*[![:space:]]}"}"
    [[ "$k" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    v="$(FLEET_SECRETS_FILE="$f" file_get "$k")" || continue
    [ -n "$v" ] || continue
    file_set "$k" "$v"; kc_set "$k" "$v"; c=$((c+1))
  done < "$f"
  printf 'imported %d secret(s) from %s\n' "$c" "$f" >&2
}

# ${NAME} -> value. Other text is copied as is. Unknown names are an error, so a typo can't
# silently produce an empty token.
cmd_render() {
  local tpl="${1:-}" out="${2:-}"
  [ -f "$tpl" ] && [ -n "$out" ] || die "usage: $ME render TEMPLATE OUT"
  local tmp; tmp="$(mktemp "${out}.XXXXXX")"; chmod 600 "$tmp"
  local line pre name val rest result
  while IFS= read -r line || [ -n "$line" ]; do
    result=""
    while [[ "$line" =~ ^([^$]*)\$\{([A-Za-z_][A-Za-z0-9_]*)\}(.*)$ ]]; do
      pre="${BASH_REMATCH[1]}"; name="${BASH_REMATCH[2]}"; rest="${BASH_REMATCH[3]}"
      val="$(get "$name")" || { rm -f "$tmp"; die "$tpl: no secret named $name"; }
      result="$result$pre$val"; line="$rest"
    done
    printf '%s\n' "$result$line" >> "$tmp"
  done < "$tpl"
  mv "$tmp" "$out"
  printf 'rendered %s\n' "$out" >&2
}

cmd_sync() {
  [ $IS_MAC -eq 1 ] || die "sync is for macOS (Keychain); on this machine the file is the only store"
  local n v c=0
  case "${1:---to-keychain}" in
    --to-keychain)
      for n in $(file_names); do v="$(file_get "$n")" && [ -n "$v" ] && { kc_set "$n" "$v"; c=$((c+1)); }; done
      printf 'copied %d name(s) from %s to the Keychain\n' "$c" "$FILE" >&2 ;;
    --from-keychain)
      for n in $(kc_names); do file_get "$n" >/dev/null 2>&1 && continue
        v="$(kc_get "$n")" && [ -n "$v" ] && { file_set "$n" "$v"; c=$((c+1)); }; done
      printf 'added %d name(s) from the Keychain to %s\n' "$c" "$FILE" >&2 ;;
    *) die "usage: $ME sync [--to-keychain|--from-keychain]" ;;
  esac
}

cmd_backup() {
  command -v op >/dev/null 2>&1 || die "the 1Password CLI (op) isn't installed here"
  [ -s "$FILE" ] || die "$FILE is empty"
  local host title vault=() tmp
  host="$(scutil --get LocalHostName 2>/dev/null || hostname -s)"
  case "$host" in beastblaster-M9S) host="aibo-linux";; esac
  title="keys.env - $host"
  [ -n "${FLEET_SECRET_OP_VAULT:-}" ] && vault=(--vault "$FLEET_SECRET_OP_VAULT")
  # The note goes in through a private template file, never on the command line (ps would show it).
  tmp="$(mktemp "${TMPDIR:-/tmp}/fleet-secret-op.XXXXXX")"; chmod 600 "$tmp"
  trap 'rm -f "$tmp"' EXIT
  python3 - "$FILE" "$title" > "$tmp" <<'PY'
import json, sys
body = open(sys.argv[1]).read()
print(json.dumps({"title": sys.argv[2], "category": "SECURE_NOTE", "tags": ["fleet", "secrets"],
                  "fields": [{"id": "notesPlain", "type": "STRING", "purpose": "NOTES", "label": "notesPlain", "value": body}]}))
PY
  if op item get "$title" ${vault[@]+"${vault[@]}"} >/dev/null 2>&1; then
    op item edit "$title" ${vault[@]+"${vault[@]}"} --template "$tmp" >/dev/null
    printf 'updated 1Password Secure Note "%s"\n' "$title" >&2
  else
    op item create ${vault[@]+"${vault[@]}"} --template "$tmp" >/dev/null
    printf 'created 1Password Secure Note "%s"\n' "$title" >&2
  fi
}

case "${1:-}" in
  get)    shift; cmd_get "$@" ;;
  set)    shift; cmd_set "$@" ;;
  rm)     shift; cmd_rm "$@" ;;
  list)   cmd_list ;;
  check)  shift; cmd_check "$@" ;;
  env)    shift; cmd_env "${1:-}" ;;
  run)    shift; cmd_run "$@" ;;
  import) shift; cmd_import "$@" ;;
  render) shift; cmd_render "$@" ;;
  sync)   shift; cmd_sync "$@" ;;
  backup) cmd_backup ;;
  where)  printf '%s\n' "$FILE" ;;
  ""|-h|--help|help) sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$1' (get set rm list check env run import render sync backup where)" ;;
esac
